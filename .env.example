# Copy to .env for local development:  cp .env.example .env
ENVIRONMENT=local
LOG_LEVEL=INFO
DEBUG_ERRORS=false

# --- AWS ---------------------------------------------------------------
AWS_REGION=us-east-1
# Point boto3 at LocalStack; leave empty/unset to hit real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
# Credentials come from the standard chain. For LocalStack any value works:
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Resources ---------------------------------------------------------
DYNAMODB_TABLE=users
S3_BUCKET=prima-tech-challenge
# Override to serve avatars through a CDN, e.g. https://cdn.example.com
# S3_PUBLIC_BASE_URL=

# --- Guard rails -------------------------------------------------------
MAX_AVATAR_BYTES=2097152
DEFAULT_PAGE_SIZE=50
